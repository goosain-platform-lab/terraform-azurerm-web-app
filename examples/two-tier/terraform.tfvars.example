# Copy to terraform.tfvars, or set these as HCP Terraform workspace variables.
app_repository                  = "my-app"
secrets_officer_group_object_id = "00000000-0000-0000-0000-000000000000"

# Settings whose values live in Key Vault: setting name => secret name.
api_key_vault_secrets = {
  "Payments__ApiKey" = "payments-api-key"
}

api_app_settings = {
  "Features__Notes" = "true"
}

# Optional Entra-only Azure SQL database.
# sql = {
#   entra_admin_login     = "sql-admins"
#   entra_admin_object_id = "00000000-0000-0000-0000-000000000000"
# }
